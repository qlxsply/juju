<!-- WPF 应用程序根对象；OnExplicitShutdown 表示所有窗口隐藏后进程仍由托盘等逻辑维持，只有代码显式调用 Shutdown 才退出。 -->
<Application x:Class="Juju.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
    <!-- Application.Resources 中的资源可被所有 XAML 视图按键引用；使用 DynamicResource 的控件会在主题服务替换画刷时自动刷新。 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 浅灰背景画刷；以键名提供给窗口和控件的 Background 属性。 -->
            <SolidColorBrush x:Key="JujuBackground" Color="#F5F5F5" />
            <!-- 深色前景画刷；保留为全局主题资源，供文本或控件按需使用。 -->
            <SolidColorBrush x:Key="JujuForeground" Color="#202020" />
            <!-- 未指定 Style 的所有 Button 共用此隐式样式，统一外边距与内容内边距。 -->
            <Style TargetType="Button">
                <!-- Margin 让相邻按钮保留间距；Padding 决定按钮边框与其内容之间的留白。 -->
                <Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="9,5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>