<!-- 将 HTML 原型中的色板、卡片、按钮和开关提取为共享 WPF 资源；单位均为 DIP。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ToolboxAccent" Color="#6078E9" />
    <SolidColorBrush x:Key="ToolboxInk" Color="#26334B" />
    <SolidColorBrush x:Key="ToolboxMuted" Color="#8995AB" />
    <SolidColorBrush x:Key="ToolboxLine" Color="#E8EBF2" />
    <SolidColorBrush x:Key="ToolboxPanel" Color="#F7F8FB" />
    <SolidColorBrush x:Key="ToolboxSelected" Color="#E9EEFC" />

    <!-- 整行工具按钮：ControlTemplate 用圆角 Border 替换 Windows 默认按钮轮廓。 -->
    <Style x:Key="ToolboxToolRow" TargetType="Button">
        <Setter Property="Height" Value="53" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F0F2FC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框标题操作按钮；Chrome 标题区内需在使用处标记 IsHitTestVisibleInChrome。 -->
    <Style x:Key="ToolboxHeaderButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EEF1F9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航项用 Tag=Active 显示选中态；Tag 仅标识视觉状态，实际页面由 Click 处理。 -->
    <Style x:Key="ToolboxNavItem" TargetType="Button">
        <Setter Property="Height" Value="39" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#607086" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2"
                                    Background="{StaticResource ToolboxAccent}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EDF0F7" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFC" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="#405FCE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolboxSubItem" TargetType="Button" BasedOn="{StaticResource ToolboxNavItem}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="27,0,8,0" />
    </Style>

    <!-- 原型中的白色分组卡片与单条设置行，设置页代码生成时可反复引用。 -->
    <Style x:Key="ToolboxSettingsCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolboxLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- CheckBox 仍保留原生键盘切换、可访问性及 IsChecked 绑定，只替换视觉树为药丸形开关。 -->
    <Style x:Key="ToolboxSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="22" Background="#CFD5E0" CornerRadius="11">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="3"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToolboxAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolboxSoftButton" TargetType="Button">
        <Setter Property="Background" Value="#F2F5FF" />
        <Setter Property="Foreground" Value="#516AD8" />
        <Setter Property="BorderBrush" Value="#DCE3F5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
