<!-- 将 HTML 原型中的色板、卡片、按钮和开关提取为共享 WPF 资源；单位均为 DIP。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:views="clr-namespace:Juju.App.Views">
    <SolidColorBrush x:Key="ToolboxAccent" Color="#6078E9" />
    <SolidColorBrush x:Key="ToolboxInk" Color="#26334B" />
    <SolidColorBrush x:Key="ToolboxMuted" Color="#8995AB" />
    <SolidColorBrush x:Key="ToolboxLine" Color="#E8EBF2" />
    <SolidColorBrush x:Key="ToolboxPanel" Color="#F7F8FB" />
    <SolidColorBrush x:Key="ToolboxSelected" Color="#E9EEFC" />

    <!-- Compacta, redondea y unifica los desplegables de todas las páginas de ajustes. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#26334B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" Margin="3,1" Padding="{TemplateBinding Padding}"
                            Background="Transparent" CornerRadius="4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#F0F3FA" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#EEF3FF" />
                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#7894EA" />
                            <Setter TargetName="ItemSurface" Property="BorderThickness" Value="2,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#26334B" />
        <Setter Property="BorderBrush" Value="#D9DEE8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Stretch"
                                      Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="0,5,5,0">
                                        <Path Data="M2,4 L6,8 L10,4" Width="10" Height="8" Stretch="Uniform"
                                              Stroke="#68758A" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="3"
                                    Background="White" BorderBrush="#D9DEE8" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#26334B" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#AEBBD5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7894EA" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7894EA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#F3F5F8" />
                            <Setter Property="Foreground" Value="#9AA5B5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolboxDatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0,4,0" />
        <Setter Property="Foreground" Value="#26334B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolboxFieldInput" TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D9DEE8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#26334B" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="1" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7894EA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#F3F5F8" />
                            <Setter Property="Foreground" Value="#9AA5B5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolboxCalendarButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="33" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="0,4,4,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F0F3FB" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E5EBF7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="35" />
        <Setter Property="Foreground" Value="#26334B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="Frame" Background="White" BorderBrush="#D9DEE8"
                                BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Style="{StaticResource ToolboxDatePickerTextBox}"
                                                   VerticalContentAlignment="Center" />
                                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource ToolboxCalendarButton}">
                                    <Path Data="M5,4 H19 A2,2 0 0 1 21,6 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V6 A2,2 0 0 1 5,4 Z M8,2.5 V6 M16,2.5 V6 M3.5,9 H20.5 M7,13 H9 M12,13 H14 M17,13 H18 M7,17 H9 M12,17 H14"
                                          Width="18" Height="18" Stretch="Uniform" Stroke="#60758F"
                                          StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="White" BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="5"
                                    Padding="4">
                                <Calendar x:Name="PART_Calendar" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7894EA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#F3F5F8" />
                            <Setter Property="Foreground" Value="#9AA5B5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 整行工具按钮：近直角浅灰 hover，避免卡片和按钮显得像浮层。 -->
    <Style x:Key="ToolboxToolRow" TargetType="Button">
        <Setter Property="Height" Value="53" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="3" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F0F2FC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框标题操作按钮；Chrome 标题区内需在使用处标记 IsHitTestVisibleInChrome。 -->
    <Style x:Key="ToolboxHeaderButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="2" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EEF1F9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolWindowActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EEF1F9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E2E7F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolWindowWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border CornerRadius="8" Background="White" BorderBrush="#D9DEE8" BorderThickness="1"
                            ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Height="48" Background="#FBFCFE">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="43" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="19" Height="19" Margin="17,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Source="{Binding Path=(views:ToolWindowChrome.ToolIcon), RelativeSource={RelativeSource TemplatedParent}}"
                                       IsHitTestVisible="False" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource ToolboxInk}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="MaximizeButton" Width="46" Height="48" Tag="Maximize" ToolTip="最大化"
                                            Style="{StaticResource ToolWindowActionButton}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Grid>
                                            <Path x:Name="MaximizeIcon" Data="M5,5 H19 V19 H5 Z" Width="12" Height="12"
                                                  Stretch="Uniform" Stroke="#354154" StrokeThickness="1.3" />
                                            <Path x:Name="RestoreIcon" Data="M8,4 H20 V16 M4,8 H16 V20 H4 Z"
                                                  Width="15" Height="15" Stretch="Uniform" Stroke="#354154"
                                                  StrokeThickness="1.3" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button Width="46" Height="48" Tag="Close" ToolTip="关闭"
                                            Style="{StaticResource ToolWindowActionButton}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18" Width="12" Height="12"
                                              Stretch="Uniform" Stroke="#354154" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource ToolboxLine}" BorderThickness="0,0,0,1"
                                        Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                            </Grid>
                            <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="30" Background="#FBFCFE"
                                    BorderBrush="{StaticResource ToolboxLine}" BorderThickness="0,1,0,0">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusLeftText" FontSize="11" Foreground="#607086"
                                               VerticalAlignment="Center"
                                               Text="{Binding Path=(views:ToolWindowChrome.StatusLeft), RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock x:Name="StatusCenterText" Grid.Column="1" FontSize="11"
                                               Foreground="#607086" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Margin="18,0"
                                               Text="{Binding Path=(views:ToolWindowChrome.StatusCenter), RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock x:Name="StatusRightText" Grid.Column="2" FontSize="11"
                                               Foreground="#607086" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Text="{Binding Path=(views:ToolWindowChrome.StatusRight), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Border>
                            <ContentPresenter ContentSource="Content" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(views:ToolWindowChrome.ShowStatusBar), RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                            <Setter TargetName="StatusBar" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=(views:ToolWindowChrome.ShowMaximizeButton), RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaximizeIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航项用 Tag=Active 显示选中态；Tag 仅标识视觉状态，实际页面由 Click 处理。 -->
    <Style x:Key="ToolboxNavItem" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#607086" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2"
                                    Background="{StaticResource ToolboxAccent}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EDF0F7" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFC" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="#405FCE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolboxSubItem" TargetType="Button" BasedOn="{StaticResource ToolboxNavItem}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="27,0,8,0" />
    </Style>

    <!-- 原型中的白色分组卡片与单条设置行，设置页代码生成时可反复引用。 -->
    <Style x:Key="ToolboxSettingsCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolboxLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- CheckBox 仍保留原生键盘切换、可访问性及 IsChecked 绑定，只替换视觉树为药丸形开关。 -->
    <Style x:Key="ToolboxSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" Background="#CBD2DE" CornerRadius="11">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="2"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToolboxAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolboxSoftButton" TargetType="Button">
        <Setter Property="Background" Value="#F2F5FF" />
        <Setter Property="Foreground" Value="#516AD8" />
        <Setter Property="BorderBrush" Value="#DCE3F5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="3" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E9EEFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 近直角单行输入框：保留 TextBox 原生键盘与选择行为，仅替换轮廓、焦点和禁用态。 -->
    <Style x:Key="ToolboxTextInput" TargetType="TextBox">
        <Setter Property="Background" Value="#FCFDFF" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolboxLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#273248" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" CornerRadius="2" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="1" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#8AA2E8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#F3F5F8"/>
                            <Setter Property="Foreground" Value="#9AA5B5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
