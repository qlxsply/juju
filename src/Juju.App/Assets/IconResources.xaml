<!--
    集中管理 WPF 矢量图标。DrawingImage 是 ImageSource 的一种实现，能被 <Image Source="..." />
    直接使用；它由 GeometryDrawing 构成，不依赖 PNG，也不需要运行时 SVG 渲染库。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        图标的默认描边色。当前 Launcher 标题栏固定为浅色，所以使用深灰以保持可读性。
        将来若标题栏也改为主题资源，可在深浅主题资源字典中为同一键提供不同颜色。
    -->
    <SolidColorBrush x:Key="IconForeground" Color="#1F2937" />

    <!-- 与原型 app-mini 对应的白色工具箱轮廓，统一用于 Launcher 与设置标题栏。 -->
    <DrawingImage x:Key="ToolboxIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M3,7 H21 V21 H3 Z M8,7 V5 A2,2 0 0 1 10,3 H14 A2,2 0 0 1 16,5 V7 M3,12 H21 M11,11 V14 H13 V11">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.8" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- JSON 工具的代码括号，使用 DrawingImage 可在不同尺寸下保持清晰。 -->
    <DrawingImage x:Key="JsonToolIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M8,8 L4,12 8,16 M16,8 L20,12 16,16 M14,5 L10,19">
                    <GeometryDrawing.Pen><Pen Brush="#6189DF" Thickness="1.8" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Toto 的日历图标：外框、日期分隔线和两个日期标记。 -->
    <DrawingImage x:Key="TotoToolIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M5,5 H19 V21 H5 Z M8,3 V7 M16,3 V7 M5,10 H19 M9,14 H11 M14,14 H16 M9,18 H11">
                    <GeometryDrawing.Pen><Pen Brush="#409C95" Thickness="1.8" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        Lucide Settings 图标的 WPF 表示，来源为 viewBox="0 0 24 24" 的 SVG。

        DrawingImage 是一种 ImageSource，它只描述“如何绘制”，不参与按钮布局。按钮中的 Image 控件负责
        最终显示尺寸和布局位置。x:Key 是资源字典键，因此消费者可写：
        <Image Source="{StaticResource SettingsIcon}" />。

        此 DrawingImage 内有三个按顺序叠加的 GeometryDrawing：
        1. 透明 24x24 矩形：建立与 SVG viewBox 相同的固定坐标边界。
        2. 齿轮外轮廓：来自 SVG 的 path。
        3. 中心圆：来自 SVG 的 circle。

        外轮廓的实际描边边界中心约为 (12,12)，中心圆圆心也是 (12,12)，所以图形在坐标上居中。
        如果某个图标因为造型不对称而需要“光学居中”，可给 DrawingGroup 添加 TranslateTransform，
        例如 X="0.25" 或 Y="-0.25" 做极小位移；本图标不需要该补偿。
    -->
    <DrawingImage x:Key="SettingsIcon">
        <!--
            Drawing 是 DrawingImage 的复杂对象属性。复杂对象不能像 Width="18" 那样用简单字符串表达，
            因此使用“属性元素语法” <DrawingImage.Drawing>...</DrawingImage.Drawing> 为它赋值。
        -->
        <DrawingImage.Drawing>
            <!-- DrawingGroup 把多个 Drawing 组合为一个图像；子项按书写顺序从后景画到前景。 -->
            <DrawingGroup>
                <!--
                    透明矩形对应 SVG 的 viewBox="0 0 24 24"：
                    - Brush="Transparent" 会参与绘制边界计算，但不会产生可见颜色。
                    - RectangleGeometry.Rect 的四个值依次是 X、Y、Width、Height。
                    - 固定边界让 DrawingImage 始终围绕 (12,12) 缩放；如果删除它，WPF 会改用实际描边
                      的最小外接矩形，来自不同 SVG 的图标可能因各自留白不同而看起来大小或位置不一致。
                -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--
                    GeometryDrawing 将“形状 Geometry”和“描边 Pen”组合起来：
                    - Geometry 使用 WPF 路径标记语法，它与 SVG path data 基本兼容。
                    - M9.671 4.136：将当前点移动到绝对坐标 (9.671,4.136)，但不绘线。
                    - a/A：绘制椭圆弧；小写 a 使用相对坐标，大写 A 使用绝对坐标。
                    - 当前 SVG fill="none"，所以此 GeometryDrawing 不设置 Brush，只使用 Pen 描边。
                -->
                <GeometryDrawing Geometry="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915">
                    <!-- Pen 也是复杂对象，所以用 GeometryDrawing.Pen 属性元素赋值。 -->
                    <GeometryDrawing.Pen>
                        <!--
                            Brush：引用统一图标颜色；Thickness=2：对应 SVG stroke-width="2"。
                            StartLineCap/EndLineCap=Round：线段两端为圆头，对应 stroke-linecap="round"。
                            LineJoin=Round：路径转角为圆角，对应 stroke-linejoin="round"。
                        -->
                        <Pen Brush="{StaticResource IconForeground}" Thickness="2" StartLineCap="Round"
                             EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!--
                    SVG <circle cx="12" cy="12" r="3" /> 转换为 EllipseGeometry：
                    Center="12,12" 是圆心；RadiusX/RadiusY 都是 3，所以结果是圆而不是椭圆。
                    GeometryDrawing 没有 Brush，圆内部透明；Pen 只绘制圆周。
                -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconForeground}" Thickness="2" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
