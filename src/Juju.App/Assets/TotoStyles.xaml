<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Juju.App.Views">
    <Style x:Key="TotoScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource ToolboxSlimScrollBar}" />
    <Style x:Key="TotoCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True" />
                        <Border Height="1" Background="#EDF0F5" VerticalAlignment="Bottom"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#25344D" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TotoGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="45" />
        <Setter Property="ColumnHeaderHeight" Value="39" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#25344D" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFF" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF2FF" /></Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle" Value="{StaticResource TotoCell}" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F7F9FC" />
                    <Setter Property="Foreground" Value="#69778D" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderBrush" Value="#E6EAF1" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TotoCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TotoContentCellText" TargetType="TextBlock" BasedOn="{StaticResource TotoCellText}">
        <Setter Property="ToolTip" Value="{Binding Content}" />
    </Style>
    <Style x:Key="TotoNoteCellText" TargetType="TextBlock" BasedOn="{StaticResource TotoCellText}">
        <Setter Property="views:TotoNoteTooltipBehavior.Note" Value="{Binding Note}" />
    </Style>
    <Style x:Key="TotoReminderPlainText" TargetType="TextBlock" BasedOn="{StaticResource TotoCellText}">
        <Setter Property="Foreground" Value="{Binding PlainForeground}" />
    </Style>
    <Style x:Key="TotoReminderContentText" TargetType="TextBlock" BasedOn="{StaticResource TotoCellText}">
        <Setter Property="Foreground" Value="{Binding ContentForeground}" />
        <Setter Property="ToolTip" Value="{Binding Content}" />
    </Style>
    <Style x:Key="TotoReminderPlanText" TargetType="TextBlock" BasedOn="{StaticResource TotoCellText}">
        <Setter Property="Foreground" Value="{Binding PlanForeground}" />
    </Style>
    <Style x:Key="TotoFirstCell" TargetType="DataGridCell" BasedOn="{StaticResource TotoCell}">
        <Setter Property="Padding" Value="9,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True" />
                        <Border x:Name="SelectionMarker" Width="3" Background="Transparent"
                                HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <Border Height="1" Background="#EDF0F5" VerticalAlignment="Bottom"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionMarker" Property="Background" Value="#6075EE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="TotoInput" TargetType="TextBox" BasedOn="{StaticResource ToolboxFieldInput}">
        <Setter Property="MinHeight" Value="35" />
    </Style>
    <Style x:Key="TotoFilterInput" TargetType="TextBox" BasedOn="{StaticResource TotoInput}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="White" BorderBrush="#DCE2EC"
                            BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                       Foreground="#93A0B2" FontSize="12" Margin="10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#6479EC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TotoMultilineInput" TargetType="TextBox" BasedOn="{StaticResource TotoInput}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="White" BorderBrush="#D9DEE8" BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="1" VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7894EA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TotoButton" TargetType="Button" BasedOn="{StaticResource ToolboxSoftButton}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#3C4D68" />
        <Setter Property="BorderBrush" Value="#DCE3EE" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="15,8" />
    </Style>
    <Style x:Key="TotoTimeBoxButton" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D7E1F3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0,9,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#91A5F6" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#6078F4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TotoPrimaryButton" TargetType="Button" BasedOn="{StaticResource TotoButton}">
        <Setter Property="Background" Value="#6075ED" />
        <Setter Property="BorderBrush" Value="#6075ED" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#4D63D9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
