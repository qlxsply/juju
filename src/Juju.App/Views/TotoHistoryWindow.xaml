<Window
    x:Class="Juju.App.Views.TotoHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:Juju.App.Views"
    Title="历史事项"
    Width="1200"
    Height="620"
    MinWidth="1200"
    MinHeight="425"
    MaxWidth="1200"
    views:ToolWindowChrome.IsEnabled="True"
    views:ToolWindowChrome.ToolIcon="{StaticResource TotoToolIcon}"
    views:ToolWindowChrome.ShowStatusBar="False"
    views:ToolWindowChrome.ShowMaximizeButton="False"
    Icon="pack://application:,,,/Juju.App;component/Assets/toto.ico"
    Style="{StaticResource ToolWindowWindowStyle}"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="48"
            ResizeBorderThickness="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="FilterBar"
            Grid.Row="0"
            Padding="10,8"
            Background="White"
            BorderBrush="#E7EBF2"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="116" />
                    <ColumnDefinition
                        Width="106" />
                    <ColumnDefinition
                        Width="306" />
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchFilter"
                    Height="35"
                    Margin="0,0,8,0"
                    Tag="搜索事项内容或备注"
                    Style="{StaticResource TotoFilterInput}"
                    AutomationProperties.Name="搜索事项内容或备注"
                    PreviewKeyDown="SearchFilter_PreviewKeyDown" />
                <ComboBox
                    x:Name="StatusFilter"
                    Grid.Column="1"
                    Height="35"
                    Margin="0,0,8,0" />
                <ComboBox
                    x:Name="PeriodPreset"
                    Grid.Column="2"
                    Height="35"
                    Margin="0,0,8,0"
                    SelectionChanged="PeriodPreset_Changed" />
                <Grid
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    ToolTip="结束时间范围">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="130" />
                        <ColumnDefinition
                            Width="32" />
                        <ColumnDefinition
                            Width="130" />
                    </Grid.ColumnDefinitions>
                    <DatePicker
                        x:Name="FromDate"
                        Height="35"
                        SelectedDateChanged="RangeDate_Changed"
                        AutomationProperties.Name="结束时间范围起始日期" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="至"
                        FontSize="11"
                        Foreground="#8795AA" />
                    <DatePicker
                        x:Name="ToDate"
                        Grid.Column="2"
                        Height="35"
                        SelectedDateChanged="RangeDate_Changed"
                        AutomationProperties.Name="结束时间范围截止日期" />
                </Grid>
                <Button
                    Grid.Column="4"
                    Height="35"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Content="查询"
                    Style="{StaticResource TotoPrimaryButton}"
                    Click="Search_Click" />
                <Button
                    Grid.Column="5"
                    Height="35"
                    VerticalAlignment="Center"
                    Content="重置"
                    Style="{StaticResource TotoButton}"
                    Click="Reset_Click" />
            </Grid>
        </Border>
        <Border
            x:Name="PaginationBar"
            Grid.Row="2"
            Padding="15,10"
            BorderBrush="#E8EBF1"
            BorderThickness="0,1,0,0"
            Background="#FBFCFE">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageLabel"
                    VerticalAlignment="Center"
                    Foreground="#7B889D"
                    FontSize="12" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,5,0"
                        Content="首页"
                        Style="{StaticResource TotoButton}"
                        Click="First_Click" />
                    <Button
                        Margin="0,0,5,0"
                        Content="上一页"
                        Style="{StaticResource TotoButton}"
                        Click="Previous_Click" />
                    <Button
                        Margin="0,0,5,0"
                        Content="下一页"
                        Style="{StaticResource TotoButton}"
                        Click="Next_Click" />
                    <Button
                        Margin="0,0,10,0"
                        Content="末页"
                        Style="{StaticResource TotoButton}"
                        Click="Last_Click" />
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="每页"
                        Foreground="#7B889D" />
                    <ComboBox
                        x:Name="PageSize"
                        Width="78"
                        Height="33"
                        SelectionChanged="PageSize_Changed" />
                </StackPanel>
            </Grid>
        </Border>
        <DataGrid
            x:Name="History"
            Grid.Row="1"
            Style="{StaticResource TotoGrid}"
            ItemsSource="{Binding HistoryItems}"
            MouseDoubleClick="History_MouseDoubleClick"
            PreviewKeyDown="History_PreviewKeyDown">
            <DataGrid.Resources>
                <Style
                    TargetType="ScrollBar"
                    BasedOn="{StaticResource TotoScrollBar}" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="260"
                    Header="事项内容"
                    Binding="{Binding Content}"
                    ElementStyle="{StaticResource TotoContentCellText}"
                    CellStyle="{StaticResource TotoFirstCell}" />
                <DataGridTextColumn
                    Width="140"
                    Header="计划时间"
                    Binding="{Binding PlannedText}"
                    ElementStyle="{StaticResource TotoCellText}" />
                <DataGridTextColumn
                    Width="140"
                    Header="提醒时间"
                    Binding="{Binding RemindText}"
                    ElementStyle="{StaticResource TotoCellText}" />
                <DataGridTextColumn
                    Width="145"
                    Header="创建时间"
                    Binding="{Binding CreatedText}"
                    ElementStyle="{StaticResource TotoCellText}" />
                <DataGridTextColumn
                    Width="210"
                    Header="备注"
                    Binding="{Binding Note}"
                    ElementStyle="{StaticResource TotoNoteCellText}" />
                <DataGridTextColumn
                    Width="95"
                    Header="结束状态"
                    Binding="{Binding StatusText}"
                    ElementStyle="{StaticResource TotoCellText}" />
                <DataGridTextColumn
                    Width="145"
                    Header="结束时间"
                    Binding="{Binding EndedText}"
                    ElementStyle="{StaticResource TotoCellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
