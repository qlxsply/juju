<Window
    x:Class="Juju.App.Views.TotoMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:Juju.App.Views"
    Title="Toto 日程提醒"
    Width="1200"
    Height="600"
    MinWidth="1200"
    MinHeight="420"
    MaxWidth="1200"
    views:ToolWindowChrome.IsEnabled="True"
    views:ToolWindowChrome.ShowMaximizeButton="False"
    views:ToolWindowChrome.ToolIcon="{StaticResource TotoToolIcon}"
    views:ToolWindowChrome.StatusLeft="进行中：0 项"
    views:ToolWindowChrome.StatusRight="Alt+A 新增 · Alt+Q 历史 · Alt+E 编辑 · Alt+F 完成"
    Icon="pack://application:,,,/Juju.App;component/Assets/toto.ico"
    Style="{StaticResource ToolWindowWindowStyle}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="48"
            ResizeBorderThickness="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <DataGrid
        x:Name="Tasks"
        Style="{StaticResource TotoGrid}"
        ItemsSource="{Binding ActiveItems}"
        MouseDoubleClick="Tasks_MouseDoubleClick"
        PreviewKeyDown="Tasks_PreviewKeyDown">
        <DataGrid.Resources>
            <Style
                TargetType="ScrollBar"
                BasedOn="{StaticResource TotoScrollBar}" />
        </DataGrid.Resources>
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="340"
                Header="事项内容"
                Binding="{Binding Content}"
                ElementStyle="{StaticResource TotoContentCellText}"
                CellStyle="{StaticResource TotoFirstCell}" />
            <DataGridTextColumn
                Width="165"
                Header="计划时间"
                Binding="{Binding PlannedText}"
                ElementStyle="{StaticResource TotoCellText}" />
            <DataGridTextColumn
                Width="165"
                Header="提醒时间"
                Binding="{Binding RemindText}"
                ElementStyle="{StaticResource TotoCellText}" />
            <DataGridTemplateColumn
                Width="115"
                Header="提醒状态">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding StatusText}"
                            Foreground="{Binding StatusForeground}"
                            Style="{StaticResource TotoCellText}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
                Width="165"
                Header="创建时间"
                Binding="{Binding CreatedText}"
                ElementStyle="{StaticResource TotoCellText}" />
            <DataGridTextColumn
                Width="220"
                Header="备注"
                Binding="{Binding Note}"
                ElementStyle="{StaticResource TotoNoteCellText}" />
        </DataGrid.Columns>
    </DataGrid>
</Window>
