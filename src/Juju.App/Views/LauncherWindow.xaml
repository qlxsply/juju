<!--
        以 WPF 控件构建工具入口：48 DIP 标题栏及图标/说明/可配置的单键工具行。
    WindowStyle=None 去掉系统标题栏；WindowChrome 保留可拖动的标题区，但不允许调整尺寸。
    真正的系统托盘和全局热键仍由 Juju.App 的 WinForms NotifyIcon/Win32 RegisterHotKey 提供。
-->
<Window x:Class="Juju.App.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:launcher="clr-namespace:Juju.App.Presentation.Launcher"
        Title="juju Toolbox" Icon="/Assets/juju.ico" Width="750" MinWidth="750" MaxWidth="750"
        SizeToContent="Height" MaxHeight="900" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource ToolboxInk}">
    <Window.Resources>
        <launcher:ToolIconConverter x:Key="ToolIconConverter" />
        <launcher:ToolGlyphBrushConverter x:Key="ToolGlyphBrushConverter" />
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight 与顶部 Grid.Height 一致；ResizeBorderThickness=0 禁止边缘拖动缩放。 -->
        <shell:WindowChrome CaptionHeight="48" CornerRadius="16" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- HWND、外框与客户区采用同一 16 DIP 圆角，避免窗口原生边缘和内容外框形状不一致。 -->
    <Border CornerRadius="16" Background="White" BorderBrush="#EDF0F7" BorderThickness="1" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <!-- 自绘标题栏；品牌标识与设置页一致，空白区域仍可拖动窗口。 -->
            <Grid DockPanel.Dock="Top" Height="48" Background="#FBFCFE"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{StaticResource ToolboxOutlineIcon}" Width="19" Height="19"
                       Margin="17,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
                <TextBlock Grid.Column="1" Text="ToolBox" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource ToolboxInk}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource ToolboxHeaderButton}"
                        ToolTip="打开设置"
                        Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="{StaticResource SettingsIcon}" Width="18" Height="18" IsHitTestVisible="False" />
                </Button>
            </Grid>

            <DockPanel Margin="11,0,11,0">
                <!--
                    标题与底部留白共约 80 DIP；列表最多 820 DIP，窗口总高度不超过 900 DIP。
                    Hidden 只隐藏轨道，不等于 Disabled；滚轮和键盘滚动仍可用。
                -->
                <ScrollViewer x:Name="ToolScroller" MaxHeight="820" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ToolRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolboxToolRow}"
                                        Height="{Binding DataContext.ToolRowHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Tag="{Binding Id}" Click="Tool_Click"
                                        AutomationProperties.Name="{Binding AccessibilityName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="29" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconKey, Converter={StaticResource ToolIconConverter}}"
                                               Width="28" Height="28" HorizontalAlignment="Left"
                                               VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" Width="34" Height="34"
                                                   FontSize="{Binding GlyphFontSize}"
                                                   Foreground="{Binding GlyphColor, Converter={StaticResource ToolGlyphBrushConverter}}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{StaticResource ToolboxMuted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="25" Height="25" Background="White"
                                                CornerRadius="6" BorderBrush="#E3E6ED" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DefaultLauncherKey}" FontSize="10"
                                                       FontWeight="Bold" Foreground="#747F92"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
