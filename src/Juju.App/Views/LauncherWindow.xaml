<!--
    以 WPF 控件复现 HTML 原型的悬浮工具入口：68 DIP 标题栏、图标/说明/单键行、底部托盘提示。
    WindowStyle=None 去掉系统标题栏；WindowChrome 保留窗口拖动、边缘缩放与贴靠。
    真正的系统托盘和全局热键仍由 Juju.App 的 WinForms NotifyIcon/Win32 RegisterHotKey 提供。
-->
<Window x:Class="Juju.App.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="juju Toolbox" Icon="/Assets/juju.ico" Width="360" Height="395" MinWidth="340" MinHeight="350"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Background="#F5F7FF"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource ToolboxInk}">
    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight 要与顶部 Grid.Height 一致；按钮须标记 IsHitTestVisibleInChrome 才能点击。 -->
        <shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 外层圆角 Border 对应原型的白色浮窗；DockPanel 将标题、页脚固定在工具列表上下。 -->
    <Border CornerRadius="16" Margin="5" Background="White" BorderBrush="#EDF0F7" BorderThickness="1">
        <Border.Effect>
            <!-- 阴影绘于留出的外边距里，模拟原型的悬浮卡片；仍由 Windows 原生 HWND 提供缩放。 -->
            <DropShadowEffect Color="#5E6D9B" BlurRadius="16" ShadowDepth="3" Opacity="0.23"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <!-- 自绘标题栏；空白区域通过代码后置 DragMove()，齿轮按钮保留点击事件。 -->
            <Grid DockPanel.Dock="Top" Height="68" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11" Margin="19,0,0,0"
                        Background="#6078E9" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{StaticResource ToolboxIcon}" Width="19" Height="19"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="Toolbox" FontSize="15" FontWeight="Bold" Foreground="#1F2A40"/>
                    <TextBlock Text="你的快捷工具中心" FontSize="11" Foreground="{StaticResource ToolboxMuted}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ToolboxHeaderButton}" ToolTip="打开设置"
                        Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="{StaticResource SettingsIcon}" Width="18" Height="18" IsHitTestVisible="False"/>
                </Button>
            </Grid>

            <!-- 页脚分隔线、绿点和全局入口热键，热键文字在 ApplySettings 中实时刷新。 -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#EFF1F5" BorderThickness="0,1,0,0"
                    Height="45" Margin="12,3,12,7">
                <Grid Margin="11,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#4CBD91" Margin="0,0,7,0"/>
                        <TextBlock Text="常驻系统托盘" FontSize="10" Foreground="{StaticResource ToolboxMuted}"/>
                    </StackPanel>
                    <TextBlock x:Name="ShortcutHint" Grid.Column="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="10" Foreground="#78849B"
                               TextTrimming="CharacterEllipsis" ToolTip="工具入口的全局快捷键"
                               Text="快捷键 Ctrl + Shift + Alt + Space"/>
                </Grid>
            </Border>

            <DockPanel Margin="11,0,11,0">
                <Grid DockPanel.Dock="Top" Height="28" Margin="11,0">
                    <TextBlock Text="所有工具" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"
                               Foreground="#98A0AF"/>
                    <TextBlock Text="单键快速启动" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="10" Foreground="#A7AEBC"/>
                </Grid>
                <!-- ScrollViewer 保证缩小窗口后各工具仍可到达；只为已实现工具展示单键。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="JsonRow" Style="{StaticResource ToolboxToolRow}" Tag="Json" Click="Tool_Click"
                                AutomationProperties.Name="打开 JSON 工具">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#EAF2FF" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image Source="{StaticResource JsonToolIcon}" Width="19" Height="19"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="JSON 格式化" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="格式化和压缩 JSON 数据" FontSize="10"
                                               Foreground="{StaticResource ToolboxMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Width="25" Height="25" Background="White"
                                        CornerRadius="6" BorderBrush="#E3E6ED" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="J" FontSize="10" FontWeight="Bold" Foreground="#747F92"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="TotoRow" Style="{StaticResource ToolboxToolRow}" Tag="Toto" Click="Tool_Click"
                                AutomationProperties.Name="打开 Toto 日程提醒">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#E7F8F3" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image Source="{StaticResource TotoToolIcon}" Width="19" Height="19"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Toto 日程提醒" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="事项管理与到期自动提醒" FontSize="10"
                                               Foreground="{StaticResource ToolboxMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Width="25" Height="25" Background="White"
                                        CornerRadius="6" BorderBrush="#E3E6ED" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="T" FontSize="10" FontWeight="Bold" Foreground="#747F92"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <!-- 尚无实现的工具仍保留原有占位入口；点击时明确提示“正在开发中”。 -->
                        <Button x:Name="EchoRow" Style="{StaticResource ToolboxToolRow}" Tag="EchoHttp" Click="Tool_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#FFF3E4" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="⇄" FontSize="18" Foreground="#DF9952"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="EchoHttp" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="HTTP 工具 · 正在开发中" FontSize="10"
                                               Foreground="{StaticResource ToolboxMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="KairosRow" Style="{StaticResource ToolboxToolRow}" Tag="Kairos" Click="Tool_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#F0EEFF" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="◷" FontSize="20" Foreground="#6B66DC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Kairos" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="时间工具 · 正在开发中" FontSize="10"
                                               Foreground="{StaticResource ToolboxMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
