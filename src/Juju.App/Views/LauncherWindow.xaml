<!-- 启动器窗口自绘标题栏；WindowStyle=None 移除系统标题栏，下面的 WindowChrome 再提供拖动、缩放和系统贴靠行为。 -->
<Window x:Class="Juju.App.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title=""
        Icon="/Assets/juju.ico" Width="380" Height="280" MinWidth="300" MinHeight="220" ResizeMode="CanResize"
        WindowStyle="None" ShowInTaskbar="False" Background="{DynamicResource JujuBackground}">
    <!-- 初始/最小尺寸保持启动器紧凑但可用；ShowInTaskbar=False 使其作为托盘启动面板而非独立任务栏项。DynamicResource 支持运行时换主题。 -->
    <!-- WindowChrome 将顶部 44 像素解释为标题区域，6 像素边缘用于调整大小；禁用原生标题按钮，改由下方按钮自绘。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!--
            标题栏图标按钮样式：
            - x:Key="LauncherAction" 是资源键，按钮用 Style="{StaticResource LauncherAction}" 引用。
            - TargetType="Button" 限定该样式用于 Button，并让 Setter 的 Property 名按 Button 属性解析。
            - 此样式位于 Window.Resources，只能被当前 LauncherWindow 及其子元素使用。
        -->
        <Style x:Key="LauncherAction" TargetType="Button">
            <!-- Background=Transparent：默认背景完全透明，但控件仍保留完整命中区域。 -->
            <Setter Property="Background" Value="Transparent" />
            <!-- BorderBrush=Transparent：边框画刷透明；当前模板没有直接显示默认 Button 边框。 -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- BorderThickness=0：四边边框厚度均为 0，避免系统按钮边框影响标题栏外观。 -->
            <Setter Property="BorderThickness" Value="0" />
            <!-- HorizontalContentAlignment=Center：按钮内容在水平方向居中。 -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <!-- VerticalContentAlignment=Center：按钮内容在垂直方向居中。 -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!--
                Template 属性的类型是 ControlTemplate，它是由 Border、ContentPresenter、Trigger 等对象
                组成的复杂对象，不是数字、颜色这类可由 Value="..." 转换的简单值，所以必须使用：
                <Setter Property="Template">
                    <Setter.Value>复杂对象</Setter.Value>
                </Setter>
                这叫 XAML 属性元素语法。Setter.Value 表示“下面这个 ControlTemplate 对象就是 Value”。
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <!--
                        ControlTemplate 完全定义 Button 的视觉树，但 Button 本身仍保留 Click、Command、
                        IsPressed 等行为。TargetType="Button" 告诉模板它服务于 Button，使 TemplateBinding
                        和 Trigger 可以安全引用 Button 的 Background、Content、IsMouseOver 等属性。
                    -->
                    <ControlTemplate TargetType="Button">
                        <!--
                            Border 是按钮的可视表面。x:Name="Surface" 让 Trigger 能按名称修改它。
                            TemplateBinding Background 把实际 Button.Background 单向传入 Border.Background，
                            因而样式默认的 Transparent 和触发器设置的悬停色都能显示出来。
                        -->
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <!--
                                ContentPresenter 是 Button.Content 的占位器。本按钮的 Content 就是下面声明的 Image。
                                Content/ContentTemplate 显式转交按钮内容及其模板；两个 Alignment 通过 TemplateBinding
                                使用上方 Setter 的 Center，因此 Image 控件在 44x44 按钮表面中居中。
                            -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <!-- 模板触发器根据 Button 状态改变视觉树，不需要在代码后置监听鼠标事件。 -->
                        <ControlTemplate.Triggers>
                            <!-- Property=IsMouseOver、Value=True：鼠标位于按钮范围内时条件成立。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- TargetName=Surface 指定上面的 Border；#E5E7EB 是浅灰悬停背景色。 -->
                                <Setter TargetName="Surface" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具列表按钮样式；内容左对齐、内边距和窄圆角使它表现为整行可点击项目。 -->
        <Style x:Key="LauncherTool" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,2" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- ContentPresenter 的 Margin 绑定到按钮 Padding，因此各实例可调整内容留白。 -->
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 两个触发器分别为悬停与按下状态提供不同的蓝色反馈。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E8EEF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D5E2F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- DockPanel 先固定自绘标题栏，工具列表自动占据剩余空间。 -->
    <DockPanel>
        <!-- 顶部 44 像素 Grid 同时是可拖动标题区；MouseLeftButtonDown 由代码后置处理窗口拖动。 -->
        <Grid DockPanel.Dock="Top" Height="44" Background="#F4F6FA" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <!-- 图标列和设置按钮列固定，中间 * 列吸收空白以将设置按钮推到最右。 -->
                <ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <!-- 使用包内 ico 显示应用标识；Margin 使其在固定标题高度内居中。 -->
            <Image Grid.Column="0" Width="28" Height="28" Margin="12,8" Source="/Assets/juju.ico" />
            <!--
                Grid.Column=2：将按钮放到第三列，即标题栏最右侧的 44 像素操作区。
                Style：复用 LauncherAction 的透明背景、悬停反馈和居中 ContentPresenter 模板。
                ToolTip：鼠标停留时显示“设置”；Click：点击后调用 Settings_Click 打开设置窗口。
                IsHitTestVisibleInChrome=True：让 WindowChrome 的标题栏区域内按钮仍能接收鼠标事件。
            -->
            <Button Grid.Column="2" Style="{StaticResource LauncherAction}" ToolTip="设置"
                    Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!--
                    Source：从 App.xaml 合并的 IconResources.xaml 中取得 SettingsIcon DrawingImage。
                    Width/Height=18：图标在 44 像素标题栏中的显示尺寸；Stretch=Uniform：保持 SVG 原始宽高比。
                    HorizontalAlignment/VerticalAlignment=Center：明确要求 Image 自身在父内容区域中居中；
                    LauncherAction 的 ContentPresenter 也会把整个 Image 放在按钮中央。
                    IsHitTestVisible=False：图标本身不截获点击，鼠标事件仍由外层 Button 接收。
                -->
                <Image Source="{StaticResource SettingsIcon}" Width="18" Height="18" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Button>
        </Grid>
        <!-- 工具数量超过窗口高度时自动显示垂直滚动条。 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- 纵向 StackPanel 以统一外边距逐项排列工具入口。 -->
            <StackPanel Margin="12">
                <!-- Tag 是代码后置识别工具的稳定标识；Content 是用户可见名称，Click 复用同一启动处理器。 -->
                <Button Style="{StaticResource LauncherTool}" Tag="Json" Content="JSON" Click="Tool_Click" />
                <Button Style="{StaticResource LauncherTool}" Tag="EchoHttp" Content="EchoHttp" Click="Tool_Click" />
                <Button Style="{StaticResource LauncherTool}" Tag="Kairos" Content="Kairos" Click="Tool_Click" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>