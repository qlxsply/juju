<Window x:Class="Juju.App.JsonToolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="juju JSON" Width="1200" Height="760" MinWidth="900" MinHeight="600" AllowDrop="True">
  <DockPanel>
    <ToolBar DockPanel.Dock="Top">
      <Button Click="New_Click" Content="新建 (Alt+A)"/>
      <Button Click="Save_Click" Content="保存 (Alt+S)"/>
      <Button Click="Format_Click" Content="格式化 (Alt+F)"/>
      <Button Click="Copy_Click" Content="复制 (Alt+C)"/>
      <Button Click="Minify_Click" Content="压缩复制 (Alt+X)"/>
      <Button Click="FileCopy_Click" Content="文件复制 (Alt+V)"/>
      <Separator/>
      <Button Click="Fold_Click" Content="全部折叠 (Alt+R)"/>
      <Button Click="Unfold_Click" Content="全部展开 (Alt+E)"/>
      <Button Click="FoldLevel_Click" Content="逐层展开 (Alt+D)"/>
      <Separator/>
      <Button Click="Diff_Click" Content="对比 (Alt+Q)"/>
      <Button Click="ExitDiff_Click" Content="退出对比"/>
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="SaveStateStatus" Text="正在加载编辑器..."/>
      <Separator/>
      <TextBlock x:Name="ValidationStatus" Text="JSON: 未知"/>
      <Separator/>
      <TextBlock x:Name="CursorStatus" Text="Ln 1, Col 1"/>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Background="#F5F5F5">
        <StackPanel DockPanel.Dock="Bottom" Margin="4">
          <ComboBox x:Name="DiffDocuments" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,0,0,4"/>
          <Button Click="Rename_Click" Content="重命名" Margin="0,0,0,4"/>
          <Button Click="Delete_Click" Content="删除"/>
        </StackPanel>
        <ListBox x:Name="Documents" AllowDrop="True" SelectionChanged="Documents_SelectionChanged" PreviewMouseLeftButtonDown="Documents_PreviewMouseLeftButtonDown" PreviewMouseMove="Documents_PreviewMouseMove" Drop="Documents_Drop">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Grid x:Name="EditorHost" Grid.Column="1"/>
    </Grid>
  </DockPanel>
</Window>
