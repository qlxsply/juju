<Window
    x:Class="Juju.App.Views.JsonToolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:Juju.App.Views"
    Title="JSON 格式化"
    Width="1200"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    views:ToolWindowChrome.IsEnabled="True"
    views:ToolWindowChrome.ToolIcon="{StaticResource JsonToolIcon}"
    views:ToolWindowChrome.StatusLeft="正在加载编辑器..."
    views:ToolWindowChrome.StatusCenter="JSON: 未知"
    views:ToolWindowChrome.StatusRight="Ln 1, Col 1"
    Icon="pack://application:,,,/Juju.App;component/Assets/json.ico"
    AutomationProperties.Name="JSON 工具"
    AllowDrop="True"
    Style="{StaticResource ToolWindowWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="48"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style
            x:Key="JsonMenuEntry"
            TargetType="MenuItem">
            <Setter Property="Foreground" Value="#34445E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="MenuItem">
                        <Border
                            x:Name="Surface"
                            Margin="4,1"
                            Background="Transparent"
                            CornerRadius="4">
                            <Grid
                                Margin="11,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="18,0,2,0"
                                    VerticalAlignment="Center"
                                    Text="{TemplateBinding InputGestureText}"
                                    Foreground="#6078CE" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF2FF" />
                                <Setter Property="Foreground" Value="#3458D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="JsonMenuSeparator"
            TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Separator">
                        <Border
                            Height="1"
                            Margin="15,5"
                            Background="#E9EDF5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="JsonMenuItem"
            TargetType="MenuItem">
            <Setter Property="Foreground" Value="#34445E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JsonMenuEntry}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="MenuItem">
                        <Grid>
                            <Border
                                x:Name="HeaderSurface"
                                Margin="1,0"
                                Padding="11,0"
                                Background="Transparent"
                                CornerRadius="4">
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                VerticalOffset="2"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border
                                    MinWidth="165"
                                    Margin="0,0,10,10"
                                    Padding="3,6"
                                    Background="White"
                                    BorderBrush="#DFE5F0"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="22"
                                            ShadowDepth="5"
                                            Opacity="0.17"
                                            Color="#20395C" />
                                    </Border.Effect>
                                    <ScrollViewer
                                        MaxHeight="450"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        CanContentScroll="True">
                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#EDF2FF" />
                                <Setter Property="Foreground" Value="#3458D2" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#EDF2FF" />
                                <Setter Property="Foreground" Value="#3458D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CompareButton"
            TargetType="Button"
            BasedOn="{StaticResource ToolboxSoftButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#34445E" />
            <Setter Property="BorderBrush" Value="#DCE3F0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style
            x:Key="ComparePrimaryButton"
            TargetType="Button"
            BasedOn="{StaticResource CompareButton}">
            <Setter Property="Background" Value="#5975EF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5975EF" />
        </Style>
        <Style
            x:Key="JsonFileItem"
            TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Height" Value="39" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ListBoxItem">
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F0F3FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF2FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D7E2FF" />
                            </Trigger>
                            <DataTrigger
                                Binding="{Binding CompareSlot}"
                                Value="A">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF2FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D7E2FF" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding CompareSlot}"
                                Value="B">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF2FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D7E2FF" />
                            </DataTrigger>
                            <Trigger Property="Tag" Value="Before">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#5975EF" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="0,3,0,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="After">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#5975EF" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="0,0,0,3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="DiffLineNumber"
            TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Background" Value="#EAF8EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="#FFF0EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Empty">
                    <Setter Property="Background" Value="#F7F9FC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DiffLineNumberTemplate">
            <Border Width="42" Style="{StaticResource DiffLineNumber}">
                <TextBlock
                    Margin="0,0,11,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding Number}"
                    Foreground="#9BA8BA"
                    FontFamily="Consolas"
                    FontSize="12" />
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel
        LastChildFill="True">
        <Menu
            Height="34"
            Padding="11,0"
            DockPanel.Dock="Top"
            Background="#FBFCFF"
            BorderBrush="#E7EBF2"
            BorderThickness="0,0,0,1">
            <MenuItem
                x:Name="FileMenu"
                Header="文件"
                Style="{StaticResource JsonMenuItem}">
                <MenuItem
                    x:Name="NewMenuItem"
                    Header="新建"
                    Tag="New"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="SaveMenuItem"
                    Header="保存"
                    Tag="Save"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <Separator
                    Style="{StaticResource JsonMenuSeparator}" />
                <MenuItem
                    x:Name="RenameMenuItem"
                    Header="重命名"
                    Tag="Rename"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="DeleteMenuItem"
                    Header="删除"
                    Tag="Delete"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
            </MenuItem>
            <MenuItem
                x:Name="EditMenu"
                Header="编辑"
                Style="{StaticResource JsonMenuItem}">
                <MenuItem
                    x:Name="FormatMenuItem"
                    Header="格式化"
                    Tag="Format"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="CopyTextMenuItem"
                    Header="复制"
                    Tag="CopyText"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="CopyMinifiedMenuItem"
                    Header="压缩复制"
                    Tag="CopyMinified"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="CopyFileMenuItem"
                    Header="复制文件"
                    Tag="CopyFile"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
            </MenuItem>
            <MenuItem
                x:Name="ViewMenu"
                Header="视图"
                Style="{StaticResource JsonMenuItem}">
                <MenuItem
                    x:Name="FoldAllMenuItem"
                    Header="全部折叠"
                    Tag="FoldAll"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="UnfoldAllMenuItem"
                    Header="全部展开"
                    Tag="UnfoldAll"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
                <MenuItem
                    x:Name="UnfoldLevelMenuItem"
                    Header="逐层展开"
                    Tag="UnfoldLevel"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
            </MenuItem>
            <MenuItem
                x:Name="ToolMenu"
                Header="工具"
                Style="{StaticResource JsonMenuItem}">
                <MenuItem
                    x:Name="EnterDiffMenuItem"
                    Header="文本对比"
                    Tag="EnterDiff"
                    Style="{StaticResource JsonMenuEntry}"
                    Click="MenuCommand_Click" />
            </MenuItem>
        </Menu>
        <Grid
            x:Name="CompareBar"
            Height="44"
            DockPanel.Dock="Top"
            Background="#FBFCFF"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="16,0,12,0"
                VerticalAlignment="Center"
                Text="文本对比"
                FontWeight="SemiBold"
                Foreground="#22324E"
                FontSize="12" />
            <TextBlock
                x:Name="CompareHint"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="#657795"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="StartCompareButton"
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Content="开始对比"
                IsEnabled="False"
                Style="{StaticResource ComparePrimaryButton}"
                Click="StartCompare_Click" />
            <Button
                Grid.Column="3"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Content="退出对比"
                Style="{StaticResource CompareButton}"
                Click="ExitCompare_Click" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="240"
                    MinWidth="190" />
                <ColumnDefinition
                    Width="5" />
                <ColumnDefinition
                    Width="*"
                    MinWidth="430" />
            </Grid.ColumnDefinitions>
            <DockPanel
                Grid.Column="0"
                Background="#FBFCFF"
                LastChildFill="True">
                <Grid
                    Height="48"
                    Margin="14,0"
                    DockPanel.Dock="Top">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="文件列表"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#22324E" />
                    <TextBlock
                        x:Name="FileCount"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#8B98AF" />
                </Grid>
                <TextBox
                    x:Name="DocumentFilter"
                    Height="34"
                    Margin="12,0,12,8"
                    Padding="11,7"
                    DockPanel.Dock="Top"
                    FontSize="12"
                    BorderBrush="#E2E7F0"
                    Background="White"
                    ToolTip="搜索文件"
                    TextChanged="DocumentFilter_TextChanged" />
                <ListBox
                    x:Name="Documents"
                    BorderThickness="0"
                    Background="Transparent"
                    AllowDrop="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{StaticResource JsonFileItem}"
                    SelectionChanged="Documents_SelectionChanged"
                    MouseDoubleClick="Documents_MouseDoubleClick"
                    PreviewKeyDown="Documents_PreviewKeyDown"
                    PreviewMouseLeftButtonDown="Documents_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="Documents_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="Documents_PreviewMouseMove"
                    DragOver="Documents_DragOver"
                    DragLeave="Documents_DragLeave"
                    Drop="Documents_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="25" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="25" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Width="16"
                                    Height="17"
                                    VerticalAlignment="Center"
                                    Data="M5,3 H15 L20,8 V21 H5 Z M15,3 V8 H20 M8,12 H16 M8,16 H16"
                                    Stroke="#8194B5"
                                    StrokeThickness="1.4"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="FileName"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding DisplayName}"
                                    Foreground="#40516B"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBox
                                    x:Name="RenameField"
                                    Grid.Column="1"
                                    Padding="5,2"
                                    Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="Collapsed"
                                    FontSize="12"
                                    BorderBrush="#6280F5"
                                    BorderThickness="1"
                                    PreviewKeyDown="RenameField_PreviewKeyDown"
                                    LostKeyboardFocus="RenameField_LostKeyboardFocus" />
                                <Border
                                    x:Name="CompareSlot"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="5"
                                    BorderBrush="#C7D3EA"
                                    BorderThickness="1"
                                    Background="White"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="SlotLabel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding CompareSlot}"
                                        Foreground="#5975EF"
                                        FontSize="11" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Value="True">
                                    <Setter TargetName="FileName" Property="Foreground" Value="#3458D2" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsRenaming}"
                                    Value="True">
                                    <Setter TargetName="FileName" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RenameField" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsCompareSelection}"
                                    Value="True">
                                    <Setter TargetName="CompareSlot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding CompareSlot}"
                                    Value="A">
                                    <Setter TargetName="FileName" Property="Foreground" Value="#3458D2" />
                                    <Setter TargetName="CompareSlot" Property="Background" Value="#5975EF" />
                                    <Setter TargetName="CompareSlot" Property="BorderBrush" Value="#5975EF" />
                                    <Setter TargetName="SlotLabel" Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding CompareSlot}"
                                    Value="B">
                                    <Setter TargetName="FileName" Property="Foreground" Value="#3458D2" />
                                    <Setter TargetName="CompareSlot" Property="Background" Value="#5975EF" />
                                    <Setter TargetName="CompareSlot" Property="BorderBrush" Value="#5975EF" />
                                    <Setter TargetName="SlotLabel" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="#E7EBF2" />
            <Grid
                Grid.Column="2"
                Background="White">
                <Grid
                    x:Name="NormalWorkspace">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="43" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="CurrentFileName"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#22324E" />
                            <Border
                                Margin="12,0,0,0"
                                Padding="7,4"
                                CornerRadius="4"
                                Background="#EFF3FF">
                                <TextBlock
                                    x:Name="JsonValidity"
                                    Text="JSON 有效"
                                    FontSize="11"
                                    Foreground="#4B74D9" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Text="自动保存"
                            FontSize="11"
                            Foreground="#8190A9" />
                        <Border
                            Grid.ColumnSpan="3"
                            Height="1"
                            VerticalAlignment="Bottom"
                            BorderBrush="#E8EDF4"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False" />
                    </Grid>
                    <Grid
                        x:Name="EditorHost"
                        Grid.Row="1" />
                </Grid>
                <Grid
                    x:Name="CompareSelectionWorkspace"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="文本对比"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#40516B" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Text="请在左侧依次选择两个不同的文件，然后点击「开始对比」"
                            Foreground="#8A99B1"
                            FontSize="12" />
                    </StackPanel>
                </Grid>
                <Grid
                    x:Name="CompareResultWorkspace"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*"
                            MinWidth="210" />
                        <ColumnDefinition
                            Width="*"
                            MinWidth="210" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="45" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0">
                            <TextBlock
                                x:Name="LeftCompareName"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#22324E"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,0,16,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="原文件 A"
                                Foreground="#6078CE"
                                FontSize="11" />
                            <Border
                                Height="1"
                                VerticalAlignment="Bottom"
                                BorderBrush="#E7EBF2"
                                BorderThickness="0,0,0,1"
                                IsHitTestVisible="False" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                x:Name="LeftDiffLineNumbersScroll"
                                Grid.Column="0"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled"
                                PreviewMouseWheel="LeftDiffLineNumbers_PreviewMouseWheel"
                                ScrollViewer.ScrollChanged="LeftDiffLineNumbersScroll_Changed">
                                <ItemsControl
                                    x:Name="LeftDiffNumbers"
                                    ItemTemplate="{StaticResource DiffLineNumberTemplate}" />
                            </ScrollViewer>
                            <RichTextBox
                                x:Name="LeftDiffRows"
                                Grid.Column="1"
                                Background="White"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="False"
                                IsDocumentEnabled="False"
                                FontFamily="Consolas"
                                FontSize="12"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.ScrollChanged="LeftDiffScroll_Changed" />
                        </Grid>
                    </Grid>
                    <Grid
                        Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="45" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0">
                            <TextBlock
                                x:Name="RightCompareName"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#22324E"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,0,16,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="对比文件 B"
                                Foreground="#6078CE"
                                FontSize="11" />
                            <Border
                                Height="1"
                                VerticalAlignment="Bottom"
                                BorderBrush="#E7EBF2"
                                BorderThickness="0,0,0,1"
                                IsHitTestVisible="False" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                x:Name="RightDiffLineNumbersScroll"
                                Grid.Column="0"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled"
                                PreviewMouseWheel="RightDiffLineNumbers_PreviewMouseWheel"
                                ScrollViewer.ScrollChanged="RightDiffLineNumbersScroll_Changed">
                                <ItemsControl
                                    x:Name="RightDiffNumbers"
                                    ItemTemplate="{StaticResource DiffLineNumberTemplate}" />
                            </ScrollViewer>
                            <RichTextBox
                                x:Name="RightDiffRows"
                                Grid.Column="1"
                                Background="White"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="False"
                                IsDocumentEnabled="False"
                                FontFamily="Consolas"
                                FontSize="12"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.ScrollChanged="RightDiffScroll_Changed" />
                        </Grid>
                    </Grid>
                    <Border
