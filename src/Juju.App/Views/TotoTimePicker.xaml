<UserControl x:Class="Juju.App.Views.TotoTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="118" Height="34">
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource TotoScrollBar}" />
        <Style x:Key="TimeOption" TargetType="ListBoxItem">
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E7EDFF" />
                                <Setter Property="Foreground" Value="#4C68E8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="TimeButton" Style="{StaticResource TotoTimeBoxButton}" Click="TimeButton_Click"
                ToolTip="选择时间" AutomationProperties.Name="选择时间">
            <Grid>
                <TextBlock x:Name="TimeText" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#263D60" FontSize="12" />
                <Path Data="M8,3 V6 M16,3 V6 M4,5 H20 A2,2 0 0 1 22,7 V19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V7 A2,2 0 0 1 4,5 Z M2,9 H22 M7,13 H9 M12,13 H14 M17,13 H19 M7,17 H9 M12,17 H14"
                      Width="17" Height="17" Stretch="Uniform" Stroke="#52627B" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Button>
        <Popup x:Name="TimePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=TimeButton}"
               VerticalOffset="4" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="130" Height="248" Background="White" BorderBrush="#D8E1F1"
                    BorderThickness="1" CornerRadius="6" Padding="5">
                <Border.Effect>
                    <DropShadowEffect Color="#253656" BlurRadius="16" ShadowDepth="4" Opacity="0.14" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="HourList" ItemContainerStyle="{StaticResource TimeOption}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Hour_SelectionChanged"
                             PreviewKeyDown="Picker_PreviewKeyDown" />
                    <ListBox x:Name="MinuteList" Grid.Column="2" ItemContainerStyle="{StaticResource TimeOption}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Minute_SelectionChanged"
                             PreviewMouseLeftButtonUp="Minute_MouseLeftButtonUp"
                             PreviewKeyDown="Picker_PreviewKeyDown" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
