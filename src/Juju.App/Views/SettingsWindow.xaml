<!-- 设置窗口；x:Class 将此声明式界面连接到同名的 C# 窗口类。 -->
<Window x:Class="Juju.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Juju.App" Title="juju 设置"
        Icon="/Assets/juju.ico" Width="860" Height="620" MinWidth="680" MinHeight="460">
    <!-- Width/Height 是初始尺寸，MinWidth/MinHeight 防止设置页在较小窗口中无法使用；Icon 使用包内资源。 -->
    <!-- 根 Grid 将可用区域分成左侧导航和右侧设置内容。 -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- 左列固定 210 像素，右列 * 占用其余全部宽度。 -->
            <ColumnDefinition Width="210" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 左侧 DockPanel 预留出与内容区的右侧间隔，并承载设置树。 -->
        <DockPanel Grid.Column="0" Margin="0,0,28,0">
            <!-- BorderThickness=0 与 Transparent 让树没有默认边框/底色；SelectedItemChanged 在用户切换节点时交给代码后置换右侧页面。 -->
            <TreeView x:Name="SettingsTree" BorderThickness="0" Background="Transparent"
                      SelectedItemChanged="SettingsTree_SelectedItemChanged">
                <!-- 层级模板把节点的 Children 集合作为子项来源，Name 属性作为每个节点的可见文字。 -->
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- Binding 在运行时从当前树节点读取 Name，不需要为每一项手工写入文本。 -->
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <!-- 资源作用域仅限此 TreeView，用来统一每个树节点的呈现。 -->
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <!-- Padding 扩大节点点击区，Margin 使相邻节点垂直分开，FontSize 统一导航文字大小。 -->
                        <Setter Property="Padding" Value="6,4" /><Setter Property="Margin" Value="0,1" />
                        <Setter Property="FontSize" Value="14" />
                        <!-- 双向默认绑定由目标属性决定；此处读取节点 IsExpanded，使代码/数据模型能指定初始展开状态。 -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>
        <!-- 右侧 DockPanel 先停靠保存栏到底部，剩余空间留给可滚动的设置页面。 -->
        <DockPanel Grid.Column="1">
            <!-- Bottom 将操作栏固定在底部；水平 StackPanel 按从左到右排列状态提示和保存按钮。 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <!-- x:Name 让代码后置能更新保存结果；VerticalAlignment 使其在按钮高度内居中。 -->
                <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- Click 映射到代码后置保存处理器；较大的 Padding 让“保存”成为清晰的操作目标。 -->
                <Button Content="保存" Padding="18,6" Click="Save_Click" />
            </StackPanel>
            <!-- Auto 仅在内容超过可见高度时显示垂直滚动条，避免较长设置页挤压底部操作栏。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- C# 根据当前树节点把对应设置控件放入此内容占位器。 -->
                <ContentControl x:Name="SectionContent" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>