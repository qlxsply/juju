<Window x:Class="Juju.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="juju 设置" Width="520" Height="540">
  <ScrollViewer Margin="20"><StackPanel><TextBlock FontSize="22" Text="设置"/><CheckBox x:Name="StartAtLogin" Margin="0,18,0,3" Content="开机自动启动"/><TextBlock Text="全局快捷键"/><TextBox x:Name="Shortcut"/><TextBlock Margin="0,10,0,3" Text="Launcher 超时（毫秒）"/><TextBox x:Name="Timeout"/><TextBlock Margin="0,18,0,3" Text="主题"/><ComboBox x:Name="Theme"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox><TextBlock Margin="0,18,0,3" Text="DataRoot"/><TextBox x:Name="DataRoot"/><StackPanel Orientation="Horizontal"><Button Content="使用已有目录" Click="UseDataRoot_Click"/><Button Content="迁移到此目录" Click="MigrateDataRoot_Click"/></StackPanel><TextBlock Margin="0,18,0,3" Text="JSON 自动保存延迟（毫秒）"/><TextBox x:Name="Autosave"/><TextBlock Text="JSON 缩进空格数"/><TextBox x:Name="Indent"/><TextBlock x:Name="Status" Margin="0,10,0,0"/><Button HorizontalAlignment="Right" Content="保存" Click="Save_Click"/></StackPanel></ScrollViewer>
</Window>
