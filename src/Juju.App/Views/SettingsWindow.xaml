<!--
    原型中的设置窗口：独立标题栏 + 固定宽度导航 + 可滚动的卡片内容。
    WindowChrome 保留 Windows 缩放/贴靠，ContentControl 展示各 ISettingsSection 的真实 WPF 页面。
-->
<Window x:Class="Juju.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Toolbox 设置" Icon="/Assets/juju.ico" Width="860" Height="590" MinWidth="670" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResize" Background="#F5F7FF"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="White" BorderBrush="#E8EBF2" BorderThickness="1" CornerRadius="16" Margin="5">
        <Border.Effect>
            <DropShadowEffect Color="#52618E" BlurRadius="19" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <!-- 标题栏的背景与底线模拟 demo 的 window-head；按钮需允许 Chrome 内命中测试。 -->
            <Grid DockPanel.Dock="Top" Height="58" Background="#FBFCFE"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Margin="20,0,0,0" CornerRadius="10" Background="#6078E9"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="{StaticResource ToolboxIcon}" Width="18" Height="18"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Toolbox 设置" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource ToolboxInk}" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <Button Grid.Column="2" Style="{StaticResource ToolboxHeaderButton}" ToolTip="关闭设置"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="×" FontSize="22" Foreground="#606E88"/>
                </Button>
                <Border BorderBrush="{StaticResource ToolboxLine}" BorderThickness="0,0,0,1"
                        VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- 导航与内容分别独立滚动，长的快捷键表不会推动导航或底部保存按钮。 -->
                <Border Grid.Column="0" Background="{StaticResource ToolboxPanel}"
                        BorderBrush="{StaticResource ToolboxLine}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,19,12,22">
                            <TextBlock Text="应用设置" FontSize="10" FontWeight="Bold" Foreground="#A2A9B8"
                                       Margin="12,0,0,10"/>
                            <Button x:Name="NavGeneral" Style="{StaticResource ToolboxNavItem}"
                                    CommandParameter="system" Click="Navigate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="☷" Width="27" FontSize="16"/>
                                    <TextBlock Text="常用设置" VerticalAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button x:Name="NavShortcut" Style="{StaticResource ToolboxNavItem}"
                                    CommandParameter="shortcut" Click="Navigate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⌨" Width="27" FontSize="15"/>
                                    <TextBlock Text="快捷键" VerticalAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button x:Name="NavStorage" Style="{StaticResource ToolboxNavItem}"
                                    CommandParameter="storage" Click="Navigate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="27" FontSize="15"/>
                                    <TextBlock Text="存储设置" VerticalAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button x:Name="NavDisplay" Style="{StaticResource ToolboxNavItem}"
                                    CommandParameter="display" Click="Navigate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="27" FontSize="15"/>
                                    <TextBlock Text="显示设置" VerticalAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button x:Name="NavAbout" Style="{StaticResource ToolboxNavItem}"
                                    CommandParameter="about" Click="Navigate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="27" FontSize="15"/>
                                    <TextBlock Text="更新与版本" VerticalAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>

                            <Border Height="1" Background="{StaticResource ToolboxLine}" Margin="11,17,11,18"/>
                            <TextBlock Text="扩展能力" FontSize="10" FontWeight="Bold" Foreground="#A2A9B8"
                                       Margin="12,0,0,10"/>
                            <!-- 工具组按钮只负责展开；点击子项才切换设置页面。 -->
                            <Button x:Name="NavTools" Style="{StaticResource ToolboxNavItem}" Click="ToolGroup_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▢" FontSize="17"/>
                                    <TextBlock Grid.Column="1" Text="工具设置" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="ToolChevron" Grid.Column="2" Text="›" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ToolChildren" Visibility="Collapsed" Margin="0,4,0,0">
                                <Button x:Name="NavJson" Style="{StaticResource ToolboxSubItem}"
                                        CommandParameter="json" Click="Navigate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#6189DF" Margin="0,0,10,0"/>
                                        <TextBlock Text="JSON 格式化" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavToto" Style="{StaticResource ToolboxSubItem}"
                                        CommandParameter="toto" Click="Navigate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#409C95" Margin="0,0,10,0"/>
                                        <TextBlock Text="Toto 日程提醒" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="juju Toolbox&#x0a;Windows 桌面工具" FontSize="10" LineHeight="17"
                                       Foreground="#AAB2BF" Margin="12,24,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <DockPanel Grid.Column="1">
                    <!-- 显式保存保证文本热键输到一半时不注册无效键；勾选/下拉可立即保存。 -->
                    <Border DockPanel.Dock="Bottom" Height="58" BorderBrush="{StaticResource ToolboxLine}"
                            BorderThickness="0,1,0,0" Background="White">
                        <Grid Margin="37,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource ToolboxMuted}"
                                       Text="更改开关后自动保存；文本输入请点击保存" VerticalAlignment="Center"/>
                            <Button x:Name="SaveButton" Grid.Column="1" Content="保存更改" Click="Save_Click"
                                    Style="{StaticResource ToolboxSoftButton}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- 每个 ISettingsSection.View 是一个真实 WPF 页面；不注入 HTML/WebView2。 -->
                        <ContentControl x:Name="SectionContent"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
