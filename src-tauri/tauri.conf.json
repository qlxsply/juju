{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Juju",
  "version": "0.1.0",
  "identifier": "com.qlxsply.juju",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Juju",
        "width": 750,
        "height": 398,
        "minWidth": 750,
        "minHeight": 320,
        "decorations": false,
        "center": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
