{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "juju",
  "version": "0.1.0",
  "identifier": "com.qlxsply.juju",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["launcher", "settings", "json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
