root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust: follow rustfmt's standard 4-space indentation.
[*.rs]
indent_size = 4

# TypeScript, React, styles, and structured configuration.
[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,json,jsonc,yml,yaml,html,xml,svg,toml}]
indent_size = 2

# Markdown may intentionally use trailing spaces for hard line breaks.
[*.{md,mdx}]
trim_trailing_whitespace = false

# Makefiles require tabs for recipe lines.
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab

# Windows command scripts conventionally use CRLF.
[*.{bat,cmd}]
end_of_line = crlf

# JSON documents and JSON with comments.
[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

